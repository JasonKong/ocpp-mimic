{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    // No Node or DOM types: timers, sockets and files do not compile here.
    // Time comes in through the Clock interface instead.
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
